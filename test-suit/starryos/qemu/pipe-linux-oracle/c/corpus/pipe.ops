# Starry pipe/fd Linux-oracle regression corpus, version 2.
# Descriptor slots are logical and local to each scenario.
version 2

scenario zero_length_and_closed_peer
pipe2 0 1 526336
read-null 0
read 0 1
close 0
write-null 1
write 1 1 0x61
close 1

scenario byte_stream_order
pipe2 0 1 526336
write 1 3 0x61
write 1 2 0x62
fionread 0
read 0 4
fionread 0
read 0 1
close 0
close 1

scenario small_atomic_write_and_poll
pipe2 0 1 526336
set-size 1 4096
get-size 1
write 1 4000 0x61
poll 1 0x4
write 1 200 0x62
fionread 0
read 0 4000
poll 1 0x4
close 0
close 1

scenario large_nonblocking_partial_write
pipe2 0 1 526336
set-size 1 4096
write 1 5000 0x63
fionread 0
write 1 1 0x64
read 0 64
poll 1 0x4
read 0 4032
poll 1 0x4
close 0
close 1

scenario page_slot_fragmentation
pipe2 0 1 526336
set-size 1 8192
write 1 5000 0x65
read 0 1000
fionread 0
poll 1 0x4
set-size 1 4096
write 1 4000 0x66
write 1 3000 0x67
fionread 0
poll 1 0x4
close 0
close 1

scenario duplicated_endpoint_lifetime
pipe2 0 1 526336
dup 1 2
close 1
write 2 1 0x68
read 0 1
dup 0 3
close 0
poll 2 0x4
close 3
poll 2 0x4
write-null 2
write 2 1 0x69
close 2

scenario eof_after_last_writer
pipe2 0 1 526336
dup 1 2
close 1
close 2
read 0 1
poll 0 0x1
close 0

scenario capacity_rounding
pipe2 0 1 526336
set-size 0 0
get-size 0
set-size 1 1
get-size 1
close 0
close 1

scenario status_flags_share_across_aliases
pipe2 0 1 524288
get-status-flags 0
get-fd-flags 0
dup2 0 2
get-fd-flags 2
set-status-flags 2 2048
get-status-flags 0
set-fd-flags 0 0
set-fd-flags 2 1
get-fd-flags 0
get-fd-flags 2
read 0 0
close 0
close 1
close 2

scenario dup2_dup3_overwrite_and_errors
pipe2 0 1 2048
dup2 0 0
dup3 0 0 0
dup3 0 2 2048
get-fd-flags 2
dup2 3 2
get-fd-flags 2
dup2 0 2
get-fd-flags 2
dup3 1 2 524288
get-fd-flags 2
close 0
close 1
close 2

scenario blocking_zero_length_and_unknown_pipe_flags
pipe2 0 1 0
read 0 0
write 1 0 97
close 0
close 1
pipe2 2 3 1073741824
get-status-flags 2
get-fd-flags 3
