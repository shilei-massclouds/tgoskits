# Starry pipe Linux-oracle corpus, version 1.
# Descriptor slots are logical and local to each scenario.
version 1

scenario zero_length_and_closed_peer
pipe2 0 1
read-null 0
read 0 1
close 0
write-null 1
write 1 1 0x61
close 1

scenario byte_stream_order
pipe2 0 1
write 1 3 0x61
write 1 2 0x62
fionread 0
read 0 4
fionread 0
read 0 1
close 0
close 1

scenario small_atomic_write_and_poll
pipe2 0 1
set-size 1 4096
get-size 1
write 1 4000 0x61
poll 1 0x4
write 1 200 0x62
fionread 0
read 0 4000
poll 1 0x4
close 0
close 1

scenario large_nonblocking_partial_write
pipe2 0 1
set-size 1 4096
write 1 5000 0x63
fionread 0
write 1 1 0x64
read 0 64
poll 1 0x4
read 0 4032
poll 1 0x4
close 0
close 1

scenario page_slot_fragmentation
pipe2 0 1
set-size 1 8192
write 1 5000 0x65
read 0 1000
fionread 0
poll 1 0x4
set-size 1 4096
write 1 4000 0x66
write 1 3000 0x67
fionread 0
poll 1 0x4
close 0
close 1

scenario duplicated_endpoint_lifetime
pipe2 0 1
dup 1 2
close 1
write 2 1 0x68
read 0 1
dup 0 3
close 0
poll 2 0x4
close 3
poll 2 0x4
write-null 2
write 2 1 0x69
close 2

scenario eof_after_last_writer
pipe2 0 1
dup 1 2
close 1
close 2
read 0 1
poll 0 0x1
close 0

scenario capacity_rounding
pipe2 0 1
set-size 0 0
get-size 0
set-size 1 1
get-size 1
close 0
close 1
