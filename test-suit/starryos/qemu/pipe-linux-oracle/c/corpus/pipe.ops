# Starry pipe/vector/poll Linux-oracle regression corpus, version 4.
# Descriptor slots are logical and local to each scenario.
version 4

scenario zero_length_and_closed_peer
pipe2 0 1 526336
read-null 0
read 0 1
close 0
write-null 1
write 1 1 0x61
close 1

scenario byte_stream_order
pipe2 0 1 526336
write 1 3 0x61
write 1 2 0x62
fionread 0
read 0 4
fionread 0
read 0 1
close 0
close 1

scenario small_atomic_write_and_poll
pipe2 0 1 526336
set-size 1 4096
get-size 1
write 1 4000 0x61
poll 1 0x4
write 1 200 0x62
fionread 0
read 0 4000
poll 1 0x4
close 0
close 1

scenario large_nonblocking_partial_write
pipe2 0 1 526336
set-size 1 4096
write 1 5000 0x63
fionread 0
write 1 1 0x64
read 0 64
poll 1 0x4
read 0 4032
poll 1 0x4
close 0
close 1

